# =============================================================================
# API Playground — External API keys
# =============================================================================
# 1. Copy this file to .env   (cp .env.example .env)
# 2. Fill ONLY the keys you actually want to enable.
# 3. Load it in IntelliJ:
#      Run > Edit Configurations > Environment variables > "Load from file" -> .env
#    Or export the variables in your shell before `mvn spring-boot:run`.
#
# .env is gitignored — never commit real keys.
# The 13 APIs without a key work out of the box (leave this file untouched).
# =============================================================================

# --- REQUIRED ----------------------------------------------------------------
# /api/v1/movies        https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# /api/v1/photos        https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# /api/v1/news          https://newsapi.org/register
NEWS_API_KEY=

# /api/v1/sports        https://www.football-data.org/client/register
FOOTBALL_DATA_KEY=

# /api/v1/balldontlie  https://fifa.balldontlie.io/
# Sent as raw "Authorization: <key>" (NO "Bearer "). FREE tier covers
# /teams + /stadiums; ALL-STAR adds /standings; GOAT adds /matches, /players.
BALLDONTLIE_API_KEY=

# --- OPTIONAL ----------------------------------------------------------------
# /api/v1/space — falls back to DEMO_KEY (heavily rate-limited)
# https://api.nasa.gov
NASA_API_KEY=
